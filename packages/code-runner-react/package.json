{
  "name": "@teovilla/code-runner-react",
  "version": "0.2.1",
  "description": "Browser real-time SDK for the code-runner service: a CodeRunnerProvider + useCodeRunnerJob hook that subscribes to private-run-<jobId> over soketi (pusher-js) and reassembles ordered stdout/stderr.",
  "license": "MIT",
  "homepage": "https://github.com/teovillanueva/code-runner/tree/main/packages/code-runner-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teovillanueva/code-runner.git",
    "directory": "packages/code-runner-react"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "pusher-js": ">=8",
    "react": ">=18"
  },
  "dependencies": {
    "@teovilla/code-runner-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18",
    "pusher-js": "^8",
    "react": "^18",
    "tsup": "^8",
    "typescript": "^5.7.2"
  }
}
