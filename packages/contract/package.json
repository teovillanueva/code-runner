{
  "name": "@teovilla/code-runner-contract",
  "version": "0.5.0",
  "type": "module",
  "description": "Single-source-of-truth wire contract for code-runner: generated TS types + zod validators + channel/event helpers shared by the SDKs and the gateway.",
  "license": "MIT",
  "homepage": "https://github.com/teovillanueva/code-runner/tree/main/packages/contract",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teovillanueva/code-runner.git",
    "directory": "packages/contract"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/wire.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./schema": "./schema/wire.schema.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs && git diff --exit-code -- gen schema || (echo '\\n✗ contract drift: regenerate with `pnpm contract` and commit' && exit 1)",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'test/**/*.ts'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "json-schema-to-zod": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0"
  }
}
