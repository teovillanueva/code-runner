# ── code-runner configuration (all config is via env, never via endpoints) ──

# Bearer token the upstream app uses to authenticate against the API.
# Generate a strong random value, e.g.  openssl rand -hex 32
EXECUTOR_API_TOKEN=dev-insecure-token-change-me

# Redis connection (used by BOTH the API and the worker).
# NOTE: the worker needs NATIVE Redis (blocking SUBSCRIBE/BRPOP). A serverless
# Redis without TCP pub/sub (e.g. Upstash REST) is only usable by the API.
REDIS_URL=redis://redis:6379

# soketi (Pusher-compatible) — read by the worker (to trigger output) and by
# the API (only if it signs channel auth). The soketi secret is NEVER returned
# by any endpoint and is NEVER persisted in Redis.
SOKETI_HOST=soketi
SOKETI_PORT=6001
SOKETI_USE_TLS=false
SOKETI_APP_ID=code-runner
SOKETI_APP_KEY=code-runner-key
SOKETI_APP_SECRET=code-runner-secret

# ── API ──
API_PORT=8080

# ── Worker ──
# Max concurrent live sandboxes this worker will hold (capacity = live sandboxes).
WORKER_MAX_SANDBOXES=8
# Docker endpoint the worker talks to (host runtime socket; no Docker-in-Docker).
DOCKER_HOST=unix:///var/run/docker.sock
# Optional container runtime override for extra isolation (e.g. runsc for gVisor).
# SANDBOX_RUNTIME=runc
# Warm-up timeout (ms): reclaim the slot if /start never arrives after /execute.
WORKER_WARMUP_MS=30000
# How often (ms) the worker writes its Redis heartbeat key.
# The reaper (05-02) uses heartbeat absence to detect dead workers.
WORKER_HEARTBEAT_INTERVAL_MS=5000
# TTL (ms) applied to the heartbeat key on each write.  Must be several times the
# interval so a missed beat or two does not falsely trigger the reaper.
WORKER_HEARTBEAT_TTL_MS=20000
# Maximum queue depth: API rejects new jobs with 429 when jobs:queue LLEN >= this value.
# Consumed by the API in plan 05-03; documented here for operator reference.
MAX_QUEUE_DEPTH=256

# ── Zygote warm-pool tier (Phase 13) — OFF by default ─────────────────────────
# Opt-in density tier. When ON, the worker wraps DockerSocketRunner + ZygoteRunner
# in a TieredRunner: zygote-eligible languages (those whose manifest declares a
# non-empty preimport set — Python today) run on a long-lived, per-(language,
# version) warm "parent" pool container that double-forks one hardened child per
# job, sharing pre-imported pages copy-on-write (~2.7x density). All other
# languages (R/Rust/SQLite) keep running as per-job hardened sandboxes on the
# Docker tier. Leaving ZYGOTE_ENABLED unset/false = DockerSocketRunner for every
# language (the safe default; identical to pre-Phase-13 behavior).
#
# SECURITY: the warm parent pool container runs PRIVILEGED with host cgroups. Only
# enable this where a hardware-isolation boundary sits BELOW the worker — e.g. the
# Fly worker, which runs its own dockerd inside a Firecracker microVM (the microVM
# is the host boundary; threat model = host-escape-only). Do NOT set true on a
# bare/shared Docker host. The per-JOB Docker-tier hardening is unchanged.
# ZYGOTE_ENABLED=false
# TCP port the in-container zygote agent listens on (worker dials it on the pool
# container's Docker-network IP). Must match the agent build.
# ZYGOTE_RELAY_PORT=7000
# Idle window (ms): a warm parent with no in-flight jobs this long is reaped to
# reclaim RAM (POOL-03).
# ZYGOTE_POOL_IDLE_MS=300000
# Base UID for per-child UID assignment inside the pool container (child uid = base + n).
# ZYGOTE_UID_BASE=100000
# Memory cap (MiB) for each warm parent pool container itself (per-child memory.max
# is derived independently from each job's Limits.MemoryMb).
# ZYGOTE_POOL_MEMORY_MB=1024

# ── Artifacts / object storage (Phase 9) ─────────────────────────────────────
# Read ONLY by the worker (the uploader/signer/lifecycle-manager). The API needs
# NO S3 creds. Leaving the bucket+endpoint EMPTY disables artifact capture — the
# worker constructs no S3Store; output pull (stdout/stderr from Redis) still works.
#
# The bucket is AUTO-CREATED by the worker on boot (S3Store.EnsureLifecycle calls
# BucketExists + MakeBucket-if-absent), so a FRESH MinIO/Tigris needs NO manual
# bucket-create step — there is no `mc mb` / createbuckets init container.
#
# Standard AWS_* env is read first; each value is overridable by the matching
# ARTIFACT_S3_* var (used only when non-empty) so Fly/Tigris `fly storage create`
# wiring is zero-translation. In dev, compose points these at the `minio` service.
#
# S3-compatible endpoint URL. Dev (MinIO): http://minio:9000. On Tigris this is
# injected automatically by `fly storage create`. Empty = artifacts disabled.
AWS_ENDPOINT_URL_S3=http://minio:9000
# Bucket artifacts are uploaded into (under the artifacts/ key prefix).
BUCKET_NAME=code-runner-artifacts
# S3 credentials. In dev these equal the MinIO root user/password below; NEVER
# logged by the worker (threat T-09-05). On Tigris they are injected as secrets.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Bucket region (MinIO accepts any value; Tigris injects the real one).
AWS_REGION=us-east-1
#
# Optional ARTIFACT_S3_* overrides — set ONLY if your provider's injected names
# ever diverge from the AWS_* names above. Unused in the default MinIO/Tigris path.
# ARTIFACT_S3_ENDPOINT=
# ARTIFACT_S3_BUCKET=
# ARTIFACT_S3_ACCESS_KEY_ID=
# ARTIFACT_S3_SECRET_ACCESS_KEY=
# ARTIFACT_S3_REGION=
#
# Optional PUBLIC endpoint used to SIGN presigned artifact URLs, when the address
# clients fetch from differs from the one the worker connects to (AWS_ENDPOINT_URL_S3).
# SigV4 signs the host, so the signed host must equal the host the client requests.
# Leave empty to presign with the connect endpoint (the common single-host case).
#   • Dev: the worker reaches MinIO at http://minio:9000 but the browser must use a
#     host-reachable address — set this to e.g. http://127.0.0.1:9000.
#   • Prod: set to your public S3/CDN domain if it differs from the internal one.
# ARTIFACT_S3_PUBLIC_ENDPOINT=
#
# MinIO root credentials (dev only). The worker's AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY above default to these so the dev stack works out of the box.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
#
# ── Retention TTLs (D-11): three independent, env-managed clocks ──
# 1) RUN_RESULT_TTL (SECONDS): Redis TTL on the persisted RunResult (job output).
RUN_RESULT_TTL=600
# 2) PRESIGNED_URL_TTL (SECONDS): expiry on the presigned GET URLs returned per
#    artifact. Default 24h. (Override alias: ARTIFACT_S3_PRESIGN_TTL, also seconds.)
PRESIGNED_URL_TTL=86400
# 3) ARTIFACT_S3_OBJECT_TTL (DAYS): provider-side bucket lifecycle expiration on
#    the artifacts/ prefix. Default 3 (days).
ARTIFACT_S3_OBJECT_TTL=3
#
# ORDERING INVARIANT (R15): the object TTL MUST be >= the presigned-URL TTL, so a
# live presigned URL never points at an already-expired object. The worker
# Validate()s this at boot and FAILS FAST otherwise (e.g. object 3d >= presign 1d).
#
# 1-DAY GRANULARITY CAVEAT: S3/Tigris bucket lifecycle expiration is whole-DAY
# granular — sub-day object cleanup is NOT achievable; ARTIFACT_S3_OBJECT_TTL is
# expressed in days and rounded up to whole days when the lifecycle rule is set.
#
# EPHEMERAL-HANDOFF model: code-runner storage is a short-lived handoff. The
# consumer (your backend) is expected to COPY artifacts to its own durable store;
# code-runner relies solely on the bucket lifecycle rule above for cleanup and
# makes no long-term retention guarantee.

# ── Stub (local E2E driver) ──
# Base URL of the API as seen from the stub (inside docker compose: http://api:8080)
API_BASE_URL=http://api:8080
# Channel auth URL (the API's optional CHAN-02 helper; enabled when ENABLE_CHANNEL_AUTH=true)
CHANNEL_AUTH_URL=http://api:8080/v1/channel-auth
# Enable the API's optional channel-auth helper (CHAN-02). Set true for local demo.
ENABLE_CHANNEL_AUTH=true

# ── OpenTelemetry (BYO observability) ─────────────────────────────────────────
# ALL UNSET by default → true no-op: the API NodeSDK and the Go worker init
# install NO exporter, open NO connection, and add zero overhead. Telemetry only
# turns on once OTEL_EXPORTER_OTLP_ENDPOINT is set. The example collector + Jaeger
# ship inert under the `observability` compose profile — enable both like so:
#
#   1. Uncomment OTEL_EXPORTER_OTLP_ENDPOINT below (point at the collector).
#   2. docker compose --profile observability up --build
#   3. Open Jaeger at http://localhost:16686  (or: bash scripts/observability-e2e.sh)
#
# Endpoint of the OTLP collector. Setting this is the ON switch. Inside compose
# the example collector is reachable as http://otel-collector:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#
# OTLP transport. We use HTTP/protobuf on :4318 (lighter Go binary); gRPC on
# :4317 also works if you prefer it.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#
# Service names. Compose defaults these per-service (code-runner-api /
# code-runner-worker); override here to relabel both halves of the trace.
# OTEL_SERVICE_NAME_API=code-runner-api
# OTEL_SERVICE_NAME_WORKER=code-runner-worker
#
# Resource attributes attached to every span/metric/log (e.g. the namespace).
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=code-runner
#
# Sampling. The example captures EVERY trace (ARG=1.0) so you always see the
# connected trace; LOWER OTEL_TRACES_SAMPLER_ARG in production (e.g. 0.05 = 5%).
# parentbased_traceidratio honors the caller's sampling decision when present.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
#
# Hard kill-switches (standard OTel env, override the endpoint gate):
#   OTEL_SDK_DISABLED=true        # disable the whole SDK regardless of endpoint
#   OTEL_TRACES_EXPORTER=none     # keep metrics/logs but emit no traces
# OTEL_SDK_DISABLED=
# OTEL_TRACES_EXPORTER=
