      "action": "SCMP_ACT_ALLOW",
      "comment": "Core syscalls required by interpreted and compiled language runtimes. Dangerous syscalls (ptrace, mount, bpf, keyctl, userfaultfd, clone3, unshare, setns, kexec_load, perf_event_open, add_key, request_key) are intentionally absent."
    },
    {
      "names": [
        "clone"
      ],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "value": 2114060288,
          "op": "SCMP_CMP_MASKED_EQ",
          "comment": "Allow clone only WITHOUT namespace-creating flags. Mask covers CLONE_NEWUSER|CLONE_NEWNS|CLONE_NEWNET|CLONE_NEWIPC|CLONE_NEWUTS|CLONE_NEWPID|CLONE_NEWCGROUP. Value=0 means none of those bits may be set."
        }
      ],
      "comment": "Allow thread creation (CLONE_THREAD, CLONE_VM, etc.) but block namespace creation. clone3 is absent; use clone for threads."
    },
    {
      "names": [
        "socket"
      ],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "value": 1,
          "op": "SCMP_CMP_EQ",
          "comment": "AF_UNIX (1) — allow Unix domain sockets for IPC (e.g. Python multiprocessing)"
        }
      ],
      "comment": "Restrict socket() to AF_UNIX only. NetworkMode=none already blocks network at the kernel level, but restricting socket domains provides defense in depth."
    }
