{
  "name": "code-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hostable, Piston-style remote code execution service with live interactive stdin and real-time output.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contract": "pnpm --filter @code-runner/contract generate",
    "contract:check": "pnpm --filter @code-runner/contract check",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @code-runner/api dev"
  }
}
