{
  "language": "sqlite",
  "version": "3",
  "aliases": ["sql"],
  "image": "executor/sqlite:3",
  "entrypoint": "main.sql",
  "compile": null,
  "run": ["sqlite3", "-batch", ":memory:", "-init", "main.sql"],
  "interactive": true,
  "defaultLimits": {
    "wallTimeMs": 30000,
    "idleMs": 10000,
    "cpuMs": 15000,
    "memoryMb": 64,
    "pids": 32,
    "outputKb": 512
  }
}
