# ── example-with-nextjs ──────────────────────────────────────────────────────
# Copy to .env.local and adjust. This app talks to a RUNNING code-runner stack
# (API + worker + soketi + redis). Bring it up from the repo root with
# `docker compose up` (see the root README / docker-compose.yml).

# ── server-only (route handlers via @teovilla/code-runner-sdk-node) ──
# Base URL of the Hono gateway (apps/api). Default port is 8080.
CODE_RUNNER_API_URL=http://localhost:8080
# Bearer token — must match the API's EXECUTOR_API_TOKEN.
EXECUTOR_API_TOKEN=dev-insecure-token-change-me
# soketi app key + secret — the secret signs private-channel auth server-side
# and must NEVER be exposed to the browser. Must match the worker/soketi creds.
SOKETI_APP_KEY=code-runner-key
SOKETI_APP_SECRET=code-runner-secret

# ── browser-exposed (NEXT_PUBLIC_*) — public app key + connection only ──
NEXT_PUBLIC_SOKETI_APP_KEY=code-runner-key
NEXT_PUBLIC_SOKETI_HOST=localhost
NEXT_PUBLIC_SOKETI_PORT=6001
NEXT_PUBLIC_SOKETI_USE_TLS=false
